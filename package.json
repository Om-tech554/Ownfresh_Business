{
  "name": "ownfresh",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "start": "node backend/index.js",
    "import-data": "npm --prefix backend run import-data",
    "backup-wp": "npm --prefix backend run backup-wp",
    "build": "cd backend && npm install --include=dev && cd ../frontend && npm install --include=dev && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    },
    "jose": "4.15.9"
  }
}
